# Copy to src/main/resources/application-local.yml (gitignored).
# Do not commit a real password.
spring:
  datasource:
    url: jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
    username: postgres.YOUR-PROJECT-REF
    password: ${DB_PASSWORD}
    driver-class-name: org.postgresql.Driver
    hikari:
      maximum-pool-size: 5
  h2:
    console:
      enabled: false
